<?xml version="1.0" encoding="utf-8"?>
<!-- 起動時のネイティブスプラッシュ。Flutter の最初のフレームが描かれると外れる。
     背景を BootstrapGate と同じ pink パレットの bg に合わせ、白からの切り替わりが
     見えないようにする（[Docs/08_platform_setup.md] §5）。
     ロゴは tool/build_brand_images.dart が密度ごとに描き出す。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_background" />

    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
